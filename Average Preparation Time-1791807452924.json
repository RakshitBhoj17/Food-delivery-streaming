          "id": 5,
          "title": "Preparation Time Over Time",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "ffzq5r2sjqo74f"
                      },
                      "spec": {
                        "dataset": "food_delivery",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH prep_times AS (\r\n    SELECT\r\n        order_id,\r\n        MIN(event_timestamp) FILTER (\r\n            WHERE event_type = 'RESTAURANT_ACCEPTED'\r\n        ) AS accepted_time,\r\n        MIN(event_timestamp) FILTER (\r\n            WHERE event_type = 'READY_FOR_PICKUP'\r\n        ) AS ready_time\r\n    FROM order_events\r\n    GROUP BY order_id\r\n),\r\nlatest AS (\r\n    SELECT MAX(ready_time) AS latest_time\r\n    FROM prep_times\r\n    WHERE ready_time IS NOT NULL\r\n)\r\nSELECT\r\n    date_bin(\r\n        INTERVAL '5 minutes',\r\n        ready_time,\r\n        TIMESTAMP '2000-01-01'\r\n    ) AS time,\r\n    ROUND(\r\n        AVG(\r\n            EXTRACT(EPOCH FROM (ready_time - accepted_time)) / 60.0\r\n        )::numeric,\r\n        2\r\n    ) AS avg_preparation_minutes\r\nFROM prep_times\r\nCROSS JOIN latest\r\nWHERE accepted_time IS NOT NULL\r\n  AND ready_time IS NOT NULL\r\n  AND ready_time >= accepted_time\r\n  AND ready_time >= latest.latest_time - INTERVAL '60 minutes'\r\nGROUP BY 1\r\nORDER BY 1;",

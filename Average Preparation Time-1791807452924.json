                        "dataset": "food_delivery",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH prep_times AS (\r\n    SELECT\r\n        order_id,\r\n        MIN(event_timestamp) FILTER (\r\n            WHERE event_type = 'RESTAURANT_ACCEPTED'\r\n        ) AS accepted_time,\r\n        MIN(event_timestamp) FILTER (\r\n            WHERE event_type = 'READY_FOR_PICKUP'\r\n        ) AS ready_time\r\n    FROM order_events\r\n    GROUP BY order_id\r\n)\r\nSELECT\r\n    ROUND(\r\n        AVG(\r\n            EXTRACT(EPOCH FROM (ready_time - accepted_time)) / 60.0\r\n        )::numeric,\r\n        2\r\n    ) AS avg_preparation_minutes\r\nFROM prep_times\r\nWHERE accepted_time IS NOT NULL\r\n  AND ready_time IS NOT NULL\r\n  AND ready_time >= accepted_time;\r\n  ",

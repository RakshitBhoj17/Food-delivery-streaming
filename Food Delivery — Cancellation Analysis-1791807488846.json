      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Cancellations Over Time",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "ffzq5r2sjqo74f"
                      },
                      "spec": {
                        "dataset": "food_delivery",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH latest AS (\r\n    SELECT MAX(event_timestamp) AS latest_time\r\n    FROM order_events\r\n)\r\nSELECT\r\n    date_bin(\r\n        INTERVAL '5 minutes',\r\n        event_timestamp,\r\n        TIMESTAMP '2000-01-01'\r\n    ) AS time,\r\n    COUNT(*) AS cancellations\r\nFROM order_events\r\nCROSS JOIN latest\r\nWHERE event_type = 'ORDER_CANCELLED'\r\n  AND event_timestamp >= latest.latest_time - INTERVAL '60 minutes'\r\nGROUP BY 1\r\nORDER BY 1;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [

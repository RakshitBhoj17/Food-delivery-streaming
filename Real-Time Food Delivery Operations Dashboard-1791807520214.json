                      "spec": {
                        "dataset": "food_delivery",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH latest AS (\r\n    SELECT MAX(placed_time) AS latest_time\r\n    FROM order_summary\r\n)\r\nSELECT\r\n    date_bin(\r\n        INTERVAL '5 minutes',\r\n        placed_time,\r\n        TIMESTAMP '2000-01-01'\r\n    ) AS time,\r\n    COUNT(*) AS orders\r\nFROM order_summary\r\nCROSS JOIN latest\r\nWHERE placed_time >= latest.latest_time - INTERVAL '60 minutes'\r\nGROUP BY 1\r\nORDER BY 1;",
                        "sql": {
